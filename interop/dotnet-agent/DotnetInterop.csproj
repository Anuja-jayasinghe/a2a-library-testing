<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Official a2aproject/a2a-dotnet SDK built from source (main 76de7f3, 2026-09-26; the only NuGet release, 1.0.0-preview2,
       dates from 2026-04-09 and predates the current API), plus the official Anthropic C# SDK. SDK checkout mounted at /sdk. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="/sdk/src/A2A/A2A.csproj" />
    <ProjectReference Include="/sdk/src/A2A.AspNetCore/A2A.AspNetCore.csproj" />
    <PackageReference Include="Anthropic" Version="12.51.0" />
  </ItemGroup>
</Project>
