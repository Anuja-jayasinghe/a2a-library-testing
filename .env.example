# Copy this file to .env, fill in a real key, then `source .env` once --
# from the repo root, or anywhere; it just sets a shell env var. Both
# server/ and client/ declare the same `anthropicApiKey` configurable
# variable, and BAL_CONFIG_DATA is Ballerina's own mechanism for
# satisfying a configurable variable's value from a plain OS environment
# variable (its content is parsed as TOML), so setting it once here
# covers both packages -- no per-package Config.toml, no -C flag needed
# on either `bal run`.
export BAL_CONFIG_DATA='anthropicApiKey = "sk-ant-your-key-here"'
